# BASEROW_OAUTH_BACKEND_URL=
# A JSON list of OpenID Connect providers. The IdP's client roles only define global
# profiles: user_roles may sign in, staff_roles / superuser_roles grant global admin.
# Workspace members, teams and access are managed in the app. A user holding none of the
# mapped client roles is refused. Configure the redirect URL in your IdP as
# <BASEROW_PUBLIC_URL>/api/sso/oidc/callback/<name>/. See docs/installation/sso-oidc.md.
# BASEROW_OIDC_PROVIDERS=[{"name": "rhbk", "display_name": "Keycloak", "issuer": "https://keycloak.example.com/realms/main", "client_id": "baserow", "client_secret": "the-secret", "user_roles": ["baserow-user"], "staff_roles": ["baserow-admins"]}]
# Make the instance OIDC-only: disable password signup and non-staff password login
# (staff can still use the password form as a break-glass escape hatch).
# BASEROW_OIDC_ONLY=

# A JSON list of external data destinations (s3, azure or filesystem) that backups and
# datalake table exports are written to. Credentials can be read from files with
# `<key>_file`. See docs/installation/data-destinations.md.
# BASEROW_DATA_DESTINATIONS=[{"name": "lake", "type": "s3", "bucket": "baserow-lake", "endpoint_url": "http://minio:9000", "access_key_id_file": "/run/secrets/lake_key", "secret_access_key_file": "/run/secrets/lake_secret"}]
# BASEROW_TABLE_EXPORT_SCHEDULE_TICK_CRONTAB=
# BASEROW_DATA_EXPORT_CHUNK_SIZE=
# BASEROW_DATA_EXPORT_MAX_ROWS_PER_FILE=
# BASEROW_DATA_EXPORT_WATERMARK_OVERLAP_SECONDS=
# BASEROW_DATA_EXPORT_TMP_DIR=
# BASEROW_DATA_EXPORT_SOFT_TIME_LIMIT=

# BASEROW_PERIODIC_FIELD_UPDATE_CRONTAB=
# BASEROW_PERIODIC_FIELD_UPDATE_UNUSED_WORKSPACE_INTERVAL_MIN=
# BASEROW_PERIODIC_FIELD_UPDATE_TIMEOUT_MINUTES=
# BASEROW_PERIODIC_FIELD_UPDATE_QUEUE_NAME=
# BASEROW_PERIODIC_FIELD_UPDATE_BATCH_COUNT=

# Only sample 10% of requests by default
# OTEL_TRACES_SAMPLER=traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
# Always sample the root django and celery spans
# OTEL_PER_MODULE_SAMPLER_OVERRIDES="opentelemetry.instrumentation.django=always_on"

