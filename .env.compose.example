# Environment for the simple local stack (docker-compose.yaml).
# Copy to .env and fill in secrets:  cp .env.compose.example .env

# Django secret key — generate one, e.g.:  openssl rand -hex 32
SECRET_KEY=changeme-generate-a-long-random-secret

# JWT signing key (optional; falls back to SECRET_KEY when empty)
BASEROW_JWT_SIGNING_KEY=

# PostgreSQL
DATABASE_NAME=baserow
DATABASE_USER=baserow
DATABASE_PASSWORD=changeme-database-password

# Redis
REDIS_PASSWORD=changeme-redis-password

# Public URL the app is served on (single origin via the caddy service)
BASEROW_PUBLIC_URL=http://localhost

# Host port the caddy proxy publishes (defaults to 80)
WEB_FRONTEND_PORT=80
