{
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["backend"],
  "vitest.rootConfig": "web-frontend/vitest.config.ts",
  "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" },
  "coverage-gutters.coverageBaseDir": "**/*coverage",
  "coverage-gutters.showLineCoverage": true,
  "sqltools.connections": [
    {
      "previewLimit": 50,
      "server": "localhost",
      "port": 5432,
      "driver": "PostgreSQL",
      "name": "baserow",
      "database": "baserow",
      "username": "baserow",
      "password": "baserow"
    }
  ],
  "editor.formatOnSave": true,
  "eslint.format.enable": true,
  "eslint.workingDirectories": [{ "mode": "auto" }],
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/*.pyc": true,
    "**/__pycache__/": true,
    "**/.nuxt/": true
  },
  "mypy.targets": [
    "backend/src/"
  ],
  "python.analysis.typeCheckingMode": "off",
  "mypy.configFile": "backend/mypy.ini",
  "mypy.dmypyExecutable": "",
  "mypy.runUsingActiveInterpreter": true,
  "python.autoComplete.extraPaths": [
    "${workspaceFolder}/backend/src"
  ],
  "python.analysis.extraPaths": [
    "${workspaceFolder}/backend/src"
  ],
  "python.envFile": "${workspaceFolder}/.vscode/env",
  "stylelint.configFile": "${workspaceFolder}/web-frontend/stylelint.config.mjs",
  "stylelint.validate": ["css", "less", "postcss", "scss"],
  "stylelint.snippet": ["css", "less", "postcss", "scss"],

  "cSpell.words": ["baserow", "BASEROW", "debugpy"],
  "search.exclude": {
    "/changelog/entries": true
  }
}
